{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RHWP Studio",
  "version": "0.9.3",
  "identifier": "com.rhwp.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:7700",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "RHWP Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczOUExRjYzOTIyNDcxMDcKUldRSGNTU1NZeCthYzlDV2VSSDFTZ3k3Y0JxQ0gvbjFmUllPK3MvZ3RqSzNMRjFVYWJ0Mm9zVVQK",
      "endpoints": [
        "https://portal.kdsys.co.kr/api/downloads/rhwp-studio/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "rhwp contributors",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "resources": {
      "packaging/cert/rhwp-studio-cert.cer": "rhwp-studio-cert.cer"
    },
    "fileAssociations": [
      {
        "ext": ["hwp"],
        "name": "HWP Document",
        "description": "아래한글 HWP 문서",
        "role": "Editor"
      },
      {
        "ext": ["hwpx"],
        "name": "HWPX Document",
        "description": "아래한글 HWPX 문서",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "packaging/installer-hooks.nsh",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
